{# Video block: displayMethod is popUp, autoplayPopUp, inline or inlineAutoplay. Autoplay pop-ups have their own video field. #}
{% set displayMethod = block.displayMethod.value ?? 'popUp' %}
{% set video = block.videos.one() %}
{% if displayMethod == 'autoplayPopUp' %}
	{% set video = block.inlineVideo.one() ?: video %}
{% endif %}
{% set poster = block.singleImage.one() %}

{% if video %}
	<section {{ attr(themeAttributes|default({})) }}>
		<div class="container">
			{% include '_components/molecules/videoPlayer/videoPlayer.twig' with {
				video: video.url,
				type: displayMethod,
				posterImage: poster,
				transform: 'aspect-16/9',
				wrapperClasses: 'aspect-video w-full overflow-hidden',
			} only %}
		</div>
	</section>
{% endif %}

{% set ratio = block.imageRatio.value ?? 'default' %}
{% set displayMode = block.imagesDisplayMode.value ?? 'default' %}
{% set images = block.images ?? [] %}
{% set images = images is array ? images : images.all() %}

{% if displayMode == 'slider' %}
	{% include '_components/molecules/imageSlider/imageSlider.twig' with { images: images, ratio: ratio, wrapperClasses: 'content-spacing' } only %}
{% else %}
	{% for image in images %}
		{% include '_components/molecules/media/media.twig' with { image: image, ratio: ratio, wrapperClasses: 'content-spacing' } only %}
	{% endfor %}
{% endif %}

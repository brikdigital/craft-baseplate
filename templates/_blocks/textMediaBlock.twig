{% set video = block.video.one() %}

<section {{ attr(themeAttributes|default({})) }}>
	{% include '_components/organisms/textMedia/textMedia.twig' with {
		text: block.content,
		image: block.image.one(),
		video: video ? video.url : '',
		imageOrVideo: block.imageOrVideo.value ?? 'image',
		videoAutoplay: block.videoAutoplay.value ?? 'pause',
		videoDisplayMode: block.videoDisplayMode.value ?? 'inline',
		ratio: block.imageRatio.value ?? 'default',
		mediaPosition: block.position.value ?? 'left',
	} only %}
</section>

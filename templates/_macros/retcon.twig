{%- macro render(field, bodySize) -%}
	{{ field | retcon([
		['attr', 'h1', { class: 'mb-12 text-40 leading-110 font-semibold text-text-titles last:mb-0 md:mb-20 md:text-52' }],
		['attr', 'h2', { class: 'mb-12 text-32 leading-120 font-semibold text-text-titles last:mb-0 md:mb-20 md:text-36' }],
		['attr', 'h3', { class: 'mb-12 text-24 leading-120 font-semibold text-text-titles last:mb-0 md:mb-20 md:text-28' }],
		['attr', 'h4', { class: 'mb-12 text-18 leading-120 font-semibold text-text-titles last:mb-0 md:mb-20 md:text-22' }],
		['attr', 'p', { class: bodySize ~ ' content-spacing text-text-primary' }],
		['attr', 'strong', { class: 'font-semibold' }],
		['attr', 'a', { class: 'underline underline-offset-4 hover:opacity-70' }],
		['attr', 'ul', { class: 'content-spacing flex list-disc flex-col gap-8 pl-24' }],
		['attr', 'ol', { class: 'content-spacing flex list-decimal flex-col gap-8 pl-24' }],
		['attr', 'ul li, ol li', { class: bodySize ~ ' text-text-primary' }],
		['wrap', 'table', '.overflow-x-auto'],
		['attr', 'figure.table', { class: 'content-spacing block' }],
		['attr', '.overflow-x-auto', { class: 'content-spacing overflow-x-auto' }],
		['attr', 'table', { class: 'w-full border-collapse' }],
		['attr', 'tr', { class: 'border-y border-border-primary/20' }],
		['attr', 'th', { class: 'bg-surface-transparent px-12 py-12 text-left align-top text-16 leading-160 font-semibold text-text-primary md:px-24 md:py-20 md:text-18' }],
		['attr', 'td', { class: 'px-12 py-12 text-left align-top text-16 leading-160 text-text-primary md:px-24 md:py-20 md:text-18' }],
		['attr', '.text-huge', { class: 'text-32! leading-110! md:text-52!' }],
		['attr', '.text-big', { class: 'text-22! leading-140! md:text-28!' }],
		['attr', '.text-small', { class: 'text-14! leading-160!' }],
		['attr', '.text-tiny', { class: 'text-12! leading-160!' }],
		['attr', 'blockquote', { class: 'mt-24 mb-24 border-l-4 border-border-secondary pl-24 text-18 leading-140 text-text-primary last:mb-0 md:text-22' }],
	]) }}
{%- endmacro -%}

{%- macro default(field) -%}
	{% import _self as retcon %}
	{{ retcon.render(field, 'text-16 md:text-18 leading-160') }}
{%- endmacro -%}

{# Large variant, for intro text #}
{%- macro intro(field) -%}
	{% import _self as retcon %}
	{{ retcon.render(field, 'text-22 md:text-28 leading-140') }}
{%- endmacro -%}

{% set text = text|default('') %}
{% set image = image|default(null) %}
{% set video = video|default('') %}
{% set imageOrVideo = imageOrVideo|default('image') %}
{% set videoAutoplay = videoAutoplay|default('pause') %}
{% set videoDisplayMode = videoDisplayMode|default('inline') %}
{% set ratio = ratio|default('default') %}
{% set mediaPosition = mediaPosition|default('left') %}
{% set wrapperClasses = wrapperClasses|default('') %}

<div class="container-grid items-center {{ wrapperClasses }}">
	<div class="col-span-full lg:col-span-6">
		{% if text is iterable %}
			{% include '_blocks/chunksHandler.twig' with { editorContent: text } only %}
		{% else %}
			{% include '_components/atoms/text/text.twig' with { html: text } only %}
		{% endif %}
	</div>

	{% include '_components/molecules/media/media.twig' with {
		image: image,
		video: video,
		imageOrVideo: imageOrVideo,
		videoAutoplay: videoAutoplay,
		videoDisplayMode: videoDisplayMode,
		ratio: ratio,
		wrapperClasses: 'order-first col-span-full lg:col-span-6 ' ~ (mediaPosition == 'right' ? 'lg:order-last' : 'lg:order-first'),
	} only %}
</div>

{% set sliderType = sliderType|default('fullWidth') %}
{% set options = options|default({}) %}
{% set slides = slides|default('') %}
{% set showNavigation = showNavigation ?? true %}
{% set showPagination = showPagination ?? false %}
{% set controlsStart = controlsStart|default('') %}
{% set controlsClasses = controlsClasses|default('mt-16') %}
{% set wrapperClasses = wrapperClasses|default('') %}
{% set config = { type: sliderType, minSlides: 1 }|merge(options) %}

<div class="relative w-full {{ wrapperClasses }}" data-swiper="{{ config|json_encode|e('html_attr') }}">
	<div class="swiper-wrapper">{{ slides }}</div>

	{% if controlsStart or showPagination or showNavigation %}
		<div class="flex items-center justify-between {{ controlsClasses }}">
			{{ controlsStart }}
			{% if showPagination %}
				{% include '_components/molecules/slider/_partials/pagination.twig' only %}
			{% endif %}
			{% if showNavigation %}
				{% include '_components/molecules/slider/_partials/navigation.twig' with { wrapperClasses: 'ml-auto' } only %}
			{% endif %}
		</div>
	{% endif %}
</div>

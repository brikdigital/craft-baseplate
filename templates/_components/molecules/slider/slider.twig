{% set sliderType = sliderType|default('fullWidth') %}
{% set slides = slides|default('') %}

{% if showNavigation is not defined %}
  {% set showNavigation = true %}
{% endif %}

{% set showPagination = showPagination|default(false) %}

<div class="relative w-full overflow-hidden" data-swiper='{
    "type": "{{sliderType}}",
    "minSlides": 1
  }'>
  <div class="swiper-wrapper">
    {{ slides }}
  </div>

  {% if showNavigation %}
    {% include "_components/molecules/slider/_partials/navigation" with { wrapperClasses: '' } %}
  {% endif %}

  {% if showPagination %}
    {% include "_components/molecules/slider/_partials/pagination" with { wrapperClasses: 'mt-16' } %}
  {% endif %}
</div>
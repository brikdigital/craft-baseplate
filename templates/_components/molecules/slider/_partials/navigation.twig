{% set wrapperClasses = wrapperClasses|default('absolute top-1/2 transform -translate-y-1/2 z-10 w-full flex justify-between') %}
{% set buttonClasses = 'relative z-10 flex size-40 items-center justify-center rounded-full bg-interactive-default text-text-inverse transition duration-200 ease-in hover:bg-interactive-hover hover:text-primary' %}

<div class="flex gap-8 {{wrapperClasses}}">
  <button class="button-prev {{buttonClasses}}">
      {% include "_components/atoms/icon/icon.twig" with {
          size: 'medium',
          icon: 'chevron-left',
          iconClasses: ''
      } %}
  </button>
  <button class="button-next {{buttonClasses}}">
      {% include "_components/atoms/icon/icon.twig" with {
          size: 'medium',
          icon: 'chevron-right',
          iconClasses: ''
      } %}
  </button>
</div>

{% set faq = faq|default(null) %}

{% if faq %}
	{% set answer = faq.answer ?? '' %}
	{% set button = faq.button.first() ?? null %}
	{% set image = faq.image.one() ?? null %}

	<details class="group border-border-secondary border-b py-24">
		<summary class="text-18 text-text-titles md:text-22 flex cursor-pointer list-none items-center gap-32 leading-140 font-semibold [&::-webkit-details-marker]:hidden">
			<span class="flex-1">{{ faq.title }}</span>
			<span class="flex shrink-0 transition-transform duration-300 ease-out group-open:rotate-45">
				{% include '_components/atoms/icon/icon.twig' with { icon: 'plus', size: 'small' } only %}
			</span>
		</summary>

		<div class="flex flex-col gap-24 pt-16 md:flex-row md:gap-40">
			<div class="flex flex-1 flex-col items-start gap-24">
				{% if answer %}
					<div class="w-full">
						{% if answer is iterable %}
							{% include '_blocks/chunksHandler.twig' with { editorContent: answer } only %}
						{% else %}
							{% include '_components/atoms/text/text.twig' with { html: answer } only %}
						{% endif %}
					</div>
				{% endif %}

				{% if button %}
					{% include '_components/molecules/buttonGroup/buttonGroup.twig' with { buttons: [button] } only %}
				{% endif %}
			</div>

			{% if image %}
				<div class="w-full shrink-0 self-start overflow-hidden md:w-1/3">
					{% include '_components/molecules/media/media.twig' with { image: image, ratio: 'aspect-4/3' } only %}
				</div>
			{% endif %}
		</div>
	</details>
{% endif %}

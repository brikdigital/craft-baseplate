{% set posterImage = posterImage|default(null)  %}
{% set transform = transform|default('aspect-16/9')  %}

{% if posterImage is null and 'youtube' in video %}
	{% set posterImage = 'https://img.youtube.com/vi/'~video|getYoutubeId~'/hqdefault.jpg' %}
{% elseif posterImage is null and 'vimeo' in video %}
	{% set posterImage = 'https://vumbnail.com/'~video|getVimeoId~'_large.jpg' %}
{% elseif posterImage is null and video ends with '.mp4' %}
    {% set posterImage = video %}
{% endif %}

{% set autoPlay = type == 'inlineAutoplay' %}

{% set wrapperClasses = wrapperClasses|default('') %}
{% set positionClasses = autoPlay ? 'right-16 bottom-16 md:right-24 md:bottom-24' : 'top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 transform' %}
{% set buttonClasses = positionClasses ~ ' absolute z-10 size-56 lg:size-64 place-items-center rounded-full bg-secondary text-primary outline-none cursor-pointer group-hover:bg-primary group-hover:text-secondary transition ease-in-out duration-200' %}
{% set iconClasses = 'fill-current block size-16 lg:size-20 -mr-px' %}

{% if type == 'inline' or type == 'inlineAutoplay' %}
  {# A poster is only used when it is a real image, not when it falls back to the video file itself #}
  {% set posterUrl = posterImage is string ? (posterImage == video ? '' : posterImage) : (posterImage ? posterImage.url : '') %}
  <video-player class="relative block group {{wrapperClasses}}" {% if posterUrl %}poster="{{ posterUrl }}"{% endif %}>
    <media-container class="relative block size-full">
      <video class="size-full object-cover" src="{{ video }}" {{ autoPlay ? 'data-autoplay muted loop preload="metadata"' : 'preload="metadata"' }} playsinline></video>
      {% if posterUrl %}<media-poster class="absolute inset-0 hidden data-visible:block"><img class="size-full object-cover" alt=""></media-poster>{% endif %}

      <media-play-button class="group {{ buttonClasses }} grid">
        <span class="hidden place-items-center group-data-ended:grid group-data-paused:grid">
          {{ inlineSvg('icons/play', ''~iconClasses, { sanitize: true, namespace: true }) }}
        </span>
        <span class="grid place-items-center group-data-ended:hidden group-data-paused:hidden">
          {{ inlineSvg('icons/pause', ''~iconClasses, { sanitize: true, namespace: true }) }}
        </span>
      </media-play-button>
    </media-container>
  </video-player>
{% else %}
  {% set popupPoster = posterImage is string ? (posterImage == video ? '' : posterImage) : (posterImage ? posterImage.url : '') %}
  <a href="{{video}}" {% if popupPoster %}data-poster="{{ popupPoster }}"{% endif %} data-lightbox data-autoplay="{{ type == 'autoplayPopUp' ? 'true' : 'false' }}" class="relative z-0 block group {{wrapperClasses}}" aria-label="{{ 'Video afspelen'|t }}">
    <button class="grid {{buttonClasses}}">
        {{ inlineSvg('icons/play', ''~iconClasses, { sanitize: true, namespace: true }) }}
    </button>

    {% include "_components/atoms/image/image.twig" with {
        image: posterImage,
        transform: transform,
        imageClasses: '',
        wrapperClasses: ''
    } %}
  </a>
{% endif %}

{% set isInText = isInText|default(false) %}

{% if blocks is defined %}
	{% set blocks = blocks is array ? blocks : blocks.all() %}
	{% for block in blocks %}
		{% if isInText %}
			{% include "_blocks/" ~ block.type ~ ".twig" with { block: block, isInText: isInText } %}
		{% else %}
			{% set settings = block.fieldLayout.getFieldByHandle('blockSettings') ? (block.blockSettings ?? {}) : {} %}

			{% set paddingTopClasses = { none: 'pt-block-none', smaller: 'pt-block-sm', default: 'pt-block-md', larger: 'pt-block-lg' } %}
			{% set paddingBottomClasses = { none: 'pb-block-none', smaller: 'pb-block-sm', default: 'pb-block-md', larger: 'pb-block-lg' } %}

			{% set paddingTop = (settings.paddingTop.value ?? settings.paddingTop ?? 'default')|lower %}
			{% set paddingBottom = (settings.paddingBottom.value ?? settings.paddingBottom ?? 'default')|lower %}

			{% set themeAttributes = {
				id: (settings.anchor ?? '')|kebab ?: false,
				class: 'scroll-mt-100 ' ~ (paddingTopClasses[paddingTop] ?? paddingTopClasses.default) ~ ' ' ~ (paddingBottomClasses[paddingBottom] ?? paddingBottomClasses.default),
			} %}
			{% include "_blocks/" ~ block.type ~ ".twig" with { block: block, isInText: isInText, themeAttributes: themeAttributes } %}
		{% endif %}
	{% endfor %}
{% endif %}

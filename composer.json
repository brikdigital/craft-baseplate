{
	"name": "brikdigital/craft-baseplate",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"license": "MPL-2.0",
	"require": {
		"aodihis/video-utils": "^3.0.2",
		"brikdigital/craft-maintenance-lock": "^5.1",
		"brikdigital/craft-statuspaginator": "^5.1.0",
		"clubstudioltd/craft-inline-svg": "^2.1",
		"craftcms/aws-s3": "^2.3.2",
		"craftcms/ckeditor": "^5.9.0",
		"craftcms/cms": "^5.11.5.1",
		"craftcms/postmark": "^3.1",
		"craftpulse/craft-colour-swatches": "5.1.0",
		"cweagans/composer-patches": "dev-main#5269693119b245e273db052f12ab23d74aca26fc",
		"hybridinteractive/craft-position-fieldtype": "^5.0",
		"lexisother/composer-patches-regex": "^1.1",
		"mmikkel/cp-clearcache": "^2.0",
		"mmikkel/retcon": "^3.2.3",
		"mostlyserious/craft-markerio": "2.2.0",
		"nystudio107/craft-minify": "^5.0",
		"nystudio107/craft-retour": "^5.0.14",
		"nystudio107/craft-seomatic": "^5.1.22",
		"nystudio107/craft-templatecomments": "^5.0",
		"nystudio107/craft-vite": "^5.0.2",
		"putyourlightson/craft-blitz": "^5.14.2",
		"putyourlightson/craft-datastar": "^1.0.4",
		"spacecatninja/imager-x": "^6.1.3",
		"spacecatninja/imager-x-gumlet-transformer": "^1.0",
		"spacecatninja/imager-x-power-pack": "^1.1.2",
		"spacecatninja/imager-x-video-adapter": "^1.1.1",
		"spicyweb/craft-batch-actions": "^2.1",
		"spicyweb/craft-embedded-assets": "^5.4.9",
		"studioespresso/craft-date-range": "^5.1",
		"superbig/craft-mjml": "^5.0",
		"teamnovu/craft-sitecopy": "^4.0.4",
		"verbb/buttonbox": "^5.0.0",
		"verbb/formie": "^4.0.5",
		"verbb/hyper": "^3.0.2",
		"verbb/icon-picker": "^3.1.6",
		"verbb/knock-knock": "^3.0.16",
		"verbb/navigation": "^4.0.13",
		"vlucas/phpdotenv": "^5.4.0",
		"webrgp/craft-ignition-core": "^1.1",
		"yiisoft/yii2-redis": "^2.0"
	},
	"require-dev": {
		"craftcms/generator": "^2.0.0",
		"nystudio107/craft-autocomplete": "^1.12",
		"yiisoft/yii2-shell": "^2.0.3"
	},
	"autoload": {
		"psr-4": {
			"brikdigital\\sitemodule\\": "modules/site-module/"
		}
	},
	"config": {
		"allow-plugins": {
			"craftcms/plugin-installer": true,
			"cweagans/composer-patches": true,
			"lexisother/composer-patches-regex": true,
			"yiisoft/yii2-composer": true
		},
		"sort-packages": true,
		"optimize-autoloader": true,
		"platform": {
			"php": "8.2"
		}
	},
	"scripts": {
		"post-create-project-cmd": [
			"@php -r \"unlink('.gitignore');\"",
			"@php -r \"unlink('LICENSE');\"",
			"@php -r \"copy('.project.gitignore', '.gitignore');\"",
			"@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\"",
			"@php -r \"unlink('composer.json');\"",
			"@php -r \"rename('composer.json.default', 'composer.json');\"",
			"@composer dump-autoload -o"
		]
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/cweagans/composer-patches.git",
			"no-api": true
		},
		{
			"type": "composer",
			"url": "https://composer.craftcms.com",
			"canonical": false
		}
	]
}
